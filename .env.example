# DonerBond Environment Configuration
# Bangladesh National Blood Donation & Emergency Response Platform

# Supabase Public Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-Side Secret Configuration (NEVER expose to browser/client-side)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# National Helpline & Support Config
NEXT_PUBLIC_NATIONAL_HOTLINE=10672
NEXT_PUBLIC_SUPPORT_EMAIL=info@donerbond.org

# Optional Third-Party Notification Providers (Configurable from Admin Console)
SMS_PROVIDER_NAME=mock
SMS_PROVIDER_API_KEY=
EMAIL_PROVIDER_NAME=mock
EMAIL_PROVIDER_API_KEY=
